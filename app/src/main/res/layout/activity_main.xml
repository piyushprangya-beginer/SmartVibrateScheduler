<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121318">

    <!-- Top App Bar -->
    <TextView
        android:id="@+id/tvAppHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1E2028"
        android:padding="16dp"
        android:text="Smart Vibrate Scheduler"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Main Content Area (Holds all 4 Tabs) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ================= TAB 1: TIMETABLE SETUP ================= -->
        <ScrollView
            android:id="@+id/tabTimeline"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvActiveSemesterInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#252836"
                    android:padding="16dp"
                    android:text="No Active Semester"
                    android:textColor="#90CAF9"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Step 1: Semester Details"
                    android:textColor="#B0BEC5"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etSemesterName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Semester Name (e.g., Fall 2026)"
                    android:text="Fall 2026"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#78909C" />

                <Button
                    android:id="@+id/btnPickEndDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="#2C3140"
                    android:text="Semester End Date: 2026-12-20 (Tap to Pick)"
                    android:textAllCaps="false"
                    android:textColor="#90CAF9" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Step 2: Build or Scan 7-Day Weekly Grid"
                    android:textColor="#B0BEC5"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnOpenWeeklyGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="#1E88E5"
                    android:text="Open / Edit 7-Day Timetable Grid"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/btnPickGalleryTimetable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="#00897B"
                    android:text="Scan Timetable Image from Gallery"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/btnScanNewSemester"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="#37474F"
                    android:text="Scan Timetable Using Camera"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Step 3: Classmate Share Code"
                    android:textColor="#B0BEC5"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvShareCodeDisplay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="#1E2028"
                    android:padding="12dp"
                    android:text="Save a timetable above to generate your Share Code"
                    android:textColor="#80CBC4"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnCopyShareCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="#00897B"
                    android:text="Copy Share Code for Classmates"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF" />

                <EditText
                    android:id="@+id/etImportCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="Paste Friend's Share Code (RPCAU-...)"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#78909C" />

                <Button
                    android:id="@+id/btnImportCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="#5E35B1"
                    android:text="Import Friend's Timetable Code"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </ScrollView>

        <!-- ================= TAB 2: TODAY DASHBOARD (DEFAULT HOME) ================= -->
        <ScrollView
            android:id="@+id/tabDashboard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- First-Launch Permission Warning Banner -->
                <LinearLayout
                    android:id="@+id/cardPermissionBanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:background="#4E2A1E"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Setup Required for Auto-Vibrate"
                        android:textColor="#FFCC80"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Grant Do Not Disturb and Alarm permissions so your phone can switch between Vibrate and Ringing automatically."
                        android:textColor="#FFE0B2"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btnBannerFixPermissions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:backgroundTint="#FB8C00"
                        android:text="Complete 1-Minute Permission Setup"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF" />
                </LinearLayout>

                <!-- Status & Live Countdown Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#1B3B2B"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvCurrentModeStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Normal Mode (Ringing)"
                        android:textColor="#81C784"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCountdownLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="NEXT CLASS STARTS IN"
                        android:textColor="#B0BEC5"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvCountdownTimer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="--:--:--"
                        android:textColor="#FFFFFF"
                        android:textSize="34sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvNextEventSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="No upcoming classes remaining today"
                        android:textColor="#E0E0E0"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Empty State Prompt -->
                <LinearLayout
                    android:id="@+id/cardEmptyState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="#252836"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No Weekly Timetable Set Up Yet"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnEmptyGoToTimeline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:backgroundTint="#1E88E5"
                        android:text="Set Up or Scan Weekly Timetable"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvTodayDateHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Today's Classes"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/containerTodayEvents"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />

                <Button
                    android:id="@+id/btnQuickAddToday"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:backgroundTint="#1E88E5"
                    android:text="+ Add Extra Class Today"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </ScrollView>

        <!-- ================= TAB 3: CALENDAR & HOLIDAYS ================= -->
        <ScrollView
            android:id="@+id/tabCalendar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <CalendarView
                    android:id="@+id/calendarView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#1E2028" />

                <!-- Day Drill-Down Panel -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="#252836"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvSelectedDateTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Selected Date"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnMarkHoliday"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:backgroundTint="#C62828"
                        android:text="Mark Entire Day as Holiday"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF" />

                    <Button
                        android:id="@+id/btnRestoreHoliday"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:backgroundTint="#37474F"
                        android:text="Restore Day from 7-Day Timetable"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF" />

                    <Button
                        android:id="@+id/btnAddEventOnDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:backgroundTint="#1E88E5"
                        android:text="+ Add Class on This Date"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF" />

                    <LinearLayout
                        android:id="@+id/containerDateEvents"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- ================= TAB 4: SETTINGS & PERMISSIONS ================= -->
        <ScrollView
            android:id="@+id/tabBrain"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- System Health Check Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#252836"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="System Permissions Checklist"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvHealthStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Checking permissions..."
                        android:textColor="#FFF59D"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/btnGrantDnd"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:backgroundTint="#1E88E5"
                        android:text="1. Allow Do Not Disturb (Ringer Control)"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF" />

                    <Button
                        android:id="@+id/btnGrantExactAlarm"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:backgroundTint="#37474F"
                        android:text="2. Allow Exact On-Time Alarms"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF" />

                    <Button
                        android:id="@+id/btnGrantBattery"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:backgroundTint="#37474F"
                        android:text="3. Allow Unrestricted Battery"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF" />

                    <Button
                        android:id="@+id/btnGrantPermissions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:backgroundTint="#37474F"
                        android:text="4. Allow Camera &amp; Wi-Fi Location"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF" />
                </LinearLayout>

                <!-- Hostel Safe Zone Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="#252836"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Hostel Wi-Fi Safe Zone"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSafeZoneStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Learned Wi-Fi: Not Set Yet"
                        android:textColor="#80CBC4"
                        android:textSize="14sp" />

                    <Switch
                        android:id="@+id/switchAutoMidnightScan"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:checked="true"
                        android:text="Auto-Learn Hostel Wi-Fi at 3:00 AM"
                        android:textColor="#FFFFFF" />

                    <Switch
                        android:id="@+id/switchOverrideSafeZone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:checked="false"
                        android:text="Disable Safe Zone (Vibrate Even in Hostel)"
                        android:textColor="#FFFFFF" />

                    <Button
                        android:id="@+id/btnForceSafeZoneNow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:backgroundTint="#00897B"
                        android:text="Lock Current Wi-Fi as Hostel Safe Zone"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- Bottom Navigation Bar (Single-Line Labels That Never Cut Off) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#1E2028"
        android:orientation="horizontal"
        android:padding="2dp">

        <Button
            android:id="@+id/btnNavTimeline"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:maxLines="1"
            android:padding="2dp"
            android:singleLine="true"
            android:text="Timetable"
            android:textAllCaps="false"
            android:textColor="#90A4AE"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnNavDashboard"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:maxLines="1"
            android:padding="2dp"
            android:singleLine="true"
            android:text="Today"
            android:textAllCaps="false"
            android:textColor="#64B5F6"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnNavCalendar"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:maxLines="1"
            android:padding="2dp"
            android:singleLine="true"
            android:text="Calendar"
            android:textAllCaps="false"
            android:textColor="#90A4AE"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnNavBrain"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:maxLines="1"
            android:padding="2dp"
            android:singleLine="true"
            android:text="Settings"
            android:textAllCaps="false"
            android:textColor="#90A4AE"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
